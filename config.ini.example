# MRAv2 Syslog Connector Configuration
# Copy this file to config.ini and update with your values
#
# RSYSLOG SETUP (receiver side)
# By default rsyslog only reads from /dev/log. To accept remote events,
# add the following to /etc/rsyslog.d/50-mrav2.conf and restart rsyslog:
#
#   For TCP (recommended, matches use_udp = false):
#     module(load="imtcp")
#     input(type="imtcp" port="514")
#
#   For UDP (matches use_udp = true):
#     module(load="imudp")
#     input(type="imudp" port="514")
#
#   To write events to a dedicated file:
#     if $fromhost-ip == 'YOUR_CONNECTOR_IP' then /var/log/mrav2-events.log
#     & stop

[lookout]
# Your Lookout entity/tenant name
entity_name = my-company

# Lookout API domain (e.g., https://api.lookout.com)
api_domain = https://api.lookout.com

# Lookout API key (OAuth client credentials)
api_key = YOUR_API_KEY_HERE

# Event types to stream (set to true/false)
threat_enabled = true
device_enabled = true
audit_enabled = false

# Stream position to start from.
# This is automatically updated as events are processed — do not edit manually
# unless you need to replay events.  Set to 0 to let start_time control replay.
stream_position = 0

# Start time for event replay (ISO format).
# Used when stream_position = 0.  If both are unset the connector defaults to
# 2020-01-01 so that all available history is replayed on first run.
# NOTE: The Lookout API treats id=0 as "live tail" — start_time is required
# to replay historical events.
# start_time = 2024-01-01T00:00:00

[syslog]
# Syslog server hostname or IP
# Used by both qradar and splunk forwarder types.
host = localhost

# Syslog server port (default: 514 for UDP, 601 for TCP)
# For Splunk Universal Forwarder syslog input, typically 5514 or a custom port.
port = 514

# Forwarder type: qradar or splunk
#   qradar  - sends LEEF 2.0 formatted messages over syslog TCP/UDP
#   splunk  - sends JSON formatted messages over syslog TCP/UDP
forwarder_type = qradar

# Protocol: set to true for UDP, false for TCP (default: false/TCP)
# TCP is recommended for production (both QRadar and Splunk). Use UDP for testing.
use_udp = false

# Optional: Custom log identifier key and value
# These are added to the syslog message for filtering/routing (QRadar path only).
log_identifier_key =
log_identifier =

[proxy]
# Optional: HTTP/HTTPS proxy configuration
# Leave empty if no proxy is needed

# Proxy address (e.g., http://proxy.company.com:8080)
address = 

# Proxy authentication (if required)
username = 
password = 
